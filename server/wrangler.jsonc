{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starspect",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-25",
  "kv_namespaces": [
    {
      "binding": "repo_cache",
      "id": "0f0cdf1a07c24ccdaa393e3e1523ef07"
    },
    {
      "binding": "user_cache",
      "id": "8f536ffe282b4df282072abb8d646d46"
    }
  ],
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "starspect",
      "database_id": "49825963-f7f8-40c9-a190-d9ee342a53a2",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
