{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starspect",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-25",
  "kv_namespaces": [
    {
      "binding": "sessions",
      "id": "1c4ee8ca3fd8427dac601fe37ac573be"
    }
  ],
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "starspect",
      "database_id": "49825963-f7f8-40c9-a190-d9ee342a53a2",
      "migrations_dir": "drizzle"
    }
  ],
  "ratelimits": [
    {
      "name": "CHECK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
